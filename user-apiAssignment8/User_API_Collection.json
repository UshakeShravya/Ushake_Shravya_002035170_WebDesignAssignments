{
  "info": {
    "name": "User Management API",
    "description": "Collection for testing User Management API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"StrongP@ss123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/user/create",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["user", "create"]
        },
        "description": "Create a new user with full name, email, and password"
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"john.doe@example.com\",\n    \"fullName\": \"John Smith\",\n    \"password\": \"NewP@ss123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/user/edit",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["user", "edit"]
        },
        "description": "Update user details (full name and/or password)"
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"john.doe@example.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/user/delete",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["user", "delete"]
        },
        "description": "Delete a user by email"
      }
    },
    {
      "name": "Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/user/getAll",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["user", "getAll"]
        },
        "description": "Retrieve all users from the database"
      }
    },
    {
      "name": "Upload User Image",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "email",
              "value": "john.doe@example.com",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/user/uploadImage",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["user", "uploadImage"]
        },
        "description": "Upload an image for a user (JPEG, PNG, or GIF only)"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
} 